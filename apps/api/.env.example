# Kết nối PostgreSQL local (thay user/password cho đúng máy của bạn)
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/employee_mgmt?schema=public"

# Bí mật ký JWT - BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32)
JWT_SECRET="change_me_to_a_long_random_string_min_32_chars"

PORT=3000
# Origin của frontend (chỉ cần khi không dùng proxy của Vite)
CORS_ORIGIN="http://localhost:5173"

# Tài khoản Admin đầu tiên, tạo bởi `npm run db:seed` (bắt buộc đổi mật khẩu ở lần đăng nhập đầu)
ADMIN_EMAIL="admin@congty.vn"
ADMIN_PASSWORD="ChangeMe123"

# true = seed thêm 30 nhân viên mẫu
SEED_DEMO=true
